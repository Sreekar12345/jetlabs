generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["relationJoins"]
}

datasource db {
  provider = "postgresql"
}

enum Role {
  STUDENT
  FACULTY
  ADMIN
}

enum TeamMemberRole {
  TEAM_LEAD
  MEMBER
}

enum VerificationStatus {
  PENDING
  VERIFIED
  CORRECTION_REQUESTED
  REJECTED
}

enum SubmissionType {
  WEEKLY
  FINAL
  IEEE
  LITERATURE
}

enum SubmissionStatus {
  DRAFT
  PENDING_REVIEW
  UNDER_REVIEW
  APPROVED
  REVISION_REQUIRED
  REJECTED
}

enum ProjectStatus {
  DISCOVERY
  RESEARCH
  EXECUTION
  EVALUATION
  COMPLETED
  ON_HOLD
}

enum HealthStatus {
  LOW
  MEDIUM
  HIGH
}

enum ReviewDecision {
  APPROVED
  REVISION_REQUIRED
  REJECTED
  ESCALATED
}

enum DifficultyLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum ProblemSource {
  FACULTY
  INDUSTRY
  RESEARCH_LAB
}

enum MilestoneStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  BLOCKED
}

model User {
  id                   String            @id @default(cuid())
  name                 String
  email                String            @unique
  passwordHash         String
  role                 Role              @default(STUDENT)
  avatar               String?
  phoneNumber          String?
  department           String?
  batchYear            String?
  rollNumber           String?
  specialization       String?
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt
  taughtTeams          Team[]            @relation("FacultyTeams")
  memberships          TeamMember[]
  performance          Performance?
  achievements         Achievement[]
  submittedSubmissions Submission[]      @relation("SubmittedBy")
  reviewedSubmissions  Submission[]      @relation("ReviewedBy")
  reviewEntries        Review[]          @relation("ReviewAuthor")
  bookmarks            ProblemBookmark[]
  createdProblems      Problem[]         @relation("ProblemCreator")
  activityEvents       ActivityEvent[]
  teamId               String?           @map("team_id")
  mentorId             String?           @map("mentor_id")
  facultyId            String?           @map("faculty_id")
  joinedTeamAt         DateTime?         @map("joined_team_at")
  assignmentRequests   TeamAssignmentRequest[]
  verificationStatus   VerificationStatus @default(PENDING) @map("verification_status")
  verifiedBy           String?            @map("verified_by")
  verifiedAt           DateTime?          @map("verified_at")
  correctionRequestedAt DateTime?         @map("correction_requested_at")
  parentPhoneNumber    String?            @map("parent_phone_number")
  linkedinUrl          String?            @map("linkedin_url")
  skills               String?            @map("skills")
  bio                  String?            @map("bio")
  facultyProjects      Project[]          @relation("ProjectFaculty")
  assignedContributions Contribution[]   @relation("ContributionAssignee")
  createdContributions  Contribution[]   @relation("ContributionAssigner")
  evaluations           Evaluation[]     @relation("EvaluatedBy")
  auditLogs             EvaluationAuditLog[] @relation("AuditLogger")
  uploadedFiles         ProjectFile[]    @relation("UserUploadedFiles")
  fileAuditLogs         FileAuditLog[]   @relation("UserFileAudits")
  isActive             Boolean            @default(true) @map("is_active")

  @@index([role])
}

model Team {
  id                           String          @id @default(cuid())
  name                         String          @map("team_name")
  batch                        String
  projectTitle                 String
  facultyId                    String          @map("faculty_id")
  projectId                    String          @unique
  teamCode                     String?         @unique @map("team_code")
  maxStudents                  Int             @default(4) @map("max_students")
  status                       String          @default("ACTIVE")
  mentorId                     String?         @map("mentor_id")
  selectedProblemStatementId   String?         @map("selected_problem_statement_id")
  createdAt                    DateTime        @default(now())
  updatedAt                    DateTime        @updatedAt
  faculty                      User            @relation("FacultyTeams", fields: [facultyId], references: [id], onDelete: Restrict)
  project                      Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  selectedProblemStatement     Problem?        @relation("TeamSelectedProblem", fields: [selectedProblemStatementId], references: [id], onDelete: SetNull)
  students                     TeamMember[]
  submissions                  Submission[]
  activityEvents               ActivityEvent[]
  tasks                        TeamTask[]
  evaluations                  Evaluation[]
  files                        ProjectFile[]   @relation("TeamFiles")

  @@index([facultyId])
  @@index([batch])
}

model TeamMember {
  id                String    @id @default(cuid())
  teamId            String
  userId            String
  roleLabel         String          @default("Member")
  role              TeamMemberRole  @default(MEMBER)
  contributionScore Int       @default(0)
  lastActiveAt      DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  team              Team      @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([teamId, userId])
  @@index([userId])
}

model Problem {
  id                   String            @id @default(cuid())
  title                String
  summary              String
  description          String
  category             String
  domain               String
  difficulty           DifficultyLevel
  source               ProblemSource
  trendingScore        Int               @default(0)
  isFacultyRecommended Boolean           @default(false)
  createdById          String?
  isAssigned           Boolean           @default(false)
  facultyGuide         String?
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt
  createdBy            User?             @relation("ProblemCreator", fields: [createdById], references: [id], onDelete: SetNull)
  bookmarks            ProblemBookmark[]
  projects             Project[]
  selectedByTeams      Team[]            @relation("TeamSelectedProblem")

  @@index([category])
  @@index([domain])
  @@index([difficulty])
  @@index([source])
  @@index([trendingScore])
}

model Project {
  id             String             @id @default(cuid())
  title          String
  description    String
  domain         String
  difficulty     DifficultyLevel
  status         ProjectStatus      @default(DISCOVERY)
  progress       Int                @default(0)
  riskScore      Int                @default(0)
  healthStatus   HealthStatus       @default(LOW)
  problemId      String?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  problem        Problem?           @relation(fields: [problemId], references: [id], onDelete: SetNull)
  team           Team?
  milestones     ProjectMilestone[]
  analytics      AnalyticsSnapshot[]
  activityEvents ActivityEvent[]
  managementStatus   String         @default("CREATED")
  progressPercentage Int            @default(0)
  projectFacultyId   String?        @map("project_faculty_id")
  projectFaculty     User?          @relation("ProjectFaculty", fields: [projectFacultyId], references: [id], onDelete: SetNull)
  projectTasks       ProjectTask[]
  weeklyMilestones   WeeklyMilestone[]
  evaluations        Evaluation[]

  @@index([status])
  @@index([healthStatus])
  @@index([riskScore])
}

model ProjectMilestone {
  id          String          @id @default(cuid())
  projectId   String
  title       String
  description String?
  stage       String
  status      MilestoneStatus @default(PENDING)
  dueAt       DateTime?
  completedAt DateTime?
  position    Int             @default(0)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  project     Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([stage])
  @@index([status])
}

model Submission {
  id           String           @id @default(cuid())
  teamId        String
  submittedById String?
  reviewedById  String?
  type          SubmissionType
  title         String
  content       String
  status        SubmissionStatus @default(PENDING_REVIEW)
  submittedAt   DateTime         @default(now())
  reviewedAt    DateTime?
  feedback      String?
  score         Int?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  team          Team             @relation(fields: [teamId], references: [id], onDelete: Cascade)
  submittedBy   User?            @relation("SubmittedBy", fields: [submittedById], references: [id], onDelete: SetNull)
  reviewedBy    User?            @relation("ReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviews       Review[]

  @@index([teamId])
  @@index([status])
  @@index([type])
}

model Review {
  id         String         @id @default(cuid())
  submissionId String
  reviewerId String
  score      Int
  comments   String
  decision   ReviewDecision
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt
  submission Submission     @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  reviewer   User           @relation("ReviewAuthor", fields: [reviewerId], references: [id], onDelete: Cascade)

  @@index([submissionId])
  @@index([reviewerId])
}

model Achievement {
  id          String   @id @default(cuid())
  userId      String
  title       String
  description String
  badge       String
  points      Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Performance {
  id              String   @id @default(cuid())
  userId          String   @unique
  score           Int      @default(0)
  attendanceScore Int      @default(0)
  submissionScore Int      @default(0)
  reviewScore     Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ProblemBookmark {
  id        String   @id @default(cuid())
  problemId String
  userId    String
  createdAt DateTime @default(now())
  problem   Problem  @relation(fields: [problemId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([problemId, userId])
  @@index([userId])
}

model AnalyticsSnapshot {
  id                   String   @id @default(cuid())
  projectId            String
  label                String
  sequence             Int
  literatureProgress   Int      @default(0)
  experimentationProgress Int   @default(0)
  writingProgress      Int      @default(0)
  submittedCount       Int      @default(0)
  reviewedCount        Int      @default(0)
  escalatedCount       Int      @default(0)
  plannedPoints        Int      @default(0)
  deliveredPoints      Int      @default(0)
  openBacklogCount     Int      @default(0)
  criticalBacklogCount Int      @default(0)
  clearedBacklogCount  Int      @default(0)
  performanceScore     Int      @default(0)
  targetScore          Int      @default(0)
  createdAt            DateTime @default(now())
  project              Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, sequence])
  @@index([projectId])
}

model ActivityEvent {
  id        String   @id @default(cuid())
  teamId     String?
  projectId  String?
  userId     String?
  type      String
  title     String
  detail    String
  createdAt DateTime @default(now())
  team      Team?    @relation(fields: [teamId], references: [id], onDelete: SetNull)
  project   Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([teamId])
  @@index([projectId])
  @@index([userId])
  @@index([createdAt])
}

model TeamAssignmentRequest {
  id          String   @id @default(cuid())
  studentId   String   @map("student_id")
  collegeName String   @map("college_name")
  department  String
  section     String
  facultyName String   @map("faculty_name")
  notes       String?
  status      String   @default("pending") // pending, approved, rejected
  createdAt   DateTime @default(now()) @map("created_at")
  student     User     @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@map("team_assignment_requests")
}

model StudentChangeLog {
  id            String   @id @default(cuid())
  studentId     String   @map("student_id")
  fieldName     String   @map("field_name")
  oldValue      String?  @map("old_value")
  newValue      String?  @map("new_value")
  changedBy     String   @map("changed_by")
  changedByRole String   @map("changed_by_role")
  reason        String?
  timestamp     DateTime @default(now())

  @@map("student_change_logs")
}

model Notification {
  id              String    @id @default(cuid())
  userId          String    @map("user_id")
  userRole        String?   @map("user_role")
  title           String?
  message         String
  type            String
  relatedEntityId String?   @map("related_entity_id")
  read            Boolean   @default(false)
  status          String    @default("UNREAD")
  createdAt       DateTime  @default(now()) @map("created_at")
  readAt          DateTime? @map("read_at")
  triggerEvent    String?   @map("trigger_event")

  @@map("notifications")
}

model TeamTask {
  id          String   @id @default(cuid())
  teamId      String   @map("team_id")
  title       String
  description String?
  week        Int
  status      String   @default("PENDING") // PENDING, IN_PROGRESS, COMPLETED
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  team        Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@index([teamId])
}

model ProjectTask {
  id          String    @id @default(cuid())
  title       String
  description String?
  dueDate     DateTime? @map("due_date")
  status      String    @default("PENDING") // PENDING, IN_PROGRESS, COMPLETED
  projectId   String    @map("project_id")
  createdBy   String    @map("created_by")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  project     Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

enum WeeklyMilestoneStatus {
  NOT_STARTED
  IN_PROGRESS
  REVIEW_PENDING
  COMPLETED
}

enum ContributionStatus {
  ASSIGNED
  IN_PROGRESS
  SUBMITTED
  UNDER_REVIEW
  REVIEWED
  REJECTED
}

model WeeklyMilestone {
  id            String                @id @default(cuid())
  projectId     String                @map("project_id")
  weekNumber    Int                   @map("week_number")
  title         String
  description   String?
  startDate     DateTime?             @map("start_date")
  dueDate       DateTime?             @map("due_date")
  status        WeeklyMilestoneStatus @default(NOT_STARTED)
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt
  project       Project               @relation(fields: [projectId], references: [id], onDelete: Cascade)
  contributions Contribution[]

  @@unique([projectId, weekNumber])
  @@index([projectId])
}

model Contribution {
  id                  String             @id @default(cuid())
  milestoneId         String             @map("milestone_id")
  assignedTo          String             @map("assigned_to")
  assignedBy          String             @map("assigned_by")
  title               String
  description         String?
  status              ContributionStatus @default(ASSIGNED)
  submissionUrl       String?            @map("submission_url")
  notes               String?
  feedback            String?
  submittedAt         DateTime?          @map("submitted_at")
  reviewedAt          DateTime?          @map("reviewed_at")
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  githubUrl           String?            @map("github_url")
  demoUrl             String?            @map("demo_url")
  uploadedFiles       String?            @map("uploaded_files")
  isLate              Boolean?           @default(false) @map("is_late")
  originalDeadline    DateTime?          @map("original_deadline")
  delayDuration       Int?               @map("delay_duration")
  facultyMarks        Int?               @map("faculty_marks")
  feedbackSuggestions String?            @map("feedback_suggestions")
  milestone           WeeklyMilestone    @relation(fields: [milestoneId], references: [id], onDelete: Cascade)
  assignee            User               @relation("ContributionAssignee", fields: [assignedTo], references: [id], onDelete: Cascade)
  assigner            User               @relation("ContributionAssigner", fields: [assignedBy], references: [id], onDelete: Cascade)
  evaluations         Evaluation[]

  @@index([milestoneId])
  @@index([assignedTo])
}

enum EvaluationStatus {
  PENDING_REVIEW
  APPROVED
  REJECTED
  REVISION_REQUIRED
  RESUBMITTED
}

model Evaluation {
  id                  String             @id @default(cuid())
  teamId              String             @map("team_id")
  projectId           String             @map("project_id")
  weekNumber          Int                @map("week_number")
  submissionId        String             @map("submission_id")
  facultyId           String             @map("faculty_id")
  reviewDate          DateTime           @default(now()) @map("review_date")
  status              EvaluationStatus   @default(PENDING_REVIEW)
  feedback            String?
  score               Float              @default(0.0)
  completeness        Float              @default(0.0)
  quality             Float              @default(0.0)
  documentation       Float              @default(0.0)
  timeliness          Float              @default(0.0)
  revisionNotes       String?            @map("revision_notes")
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  team                Team               @relation(fields: [teamId], references: [id], onDelete: Cascade)
  project             Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  contribution        Contribution       @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  faculty             User               @relation("EvaluatedBy", fields: [facultyId], references: [id], onDelete: Restrict)
  auditLogs           EvaluationAuditLog[]

  @@index([teamId])
  @@index([projectId])
  @@index([submissionId])
}

model EvaluationAuditLog {
  id             String           @id @default(cuid())
  evaluationId   String           @map("evaluation_id")
  facultyId      String           @map("faculty_id")
  previousStatus String           @map("previous_status")
  newStatus      String           @map("new_status")
  timestamp      DateTime         @default(now())

  evaluation     Evaluation       @relation(fields: [evaluationId], references: [id], onDelete: Cascade)
  faculty        User             @relation("AuditLogger", fields: [facultyId], references: [id], onDelete: Restrict)

  @@index([evaluationId])
  @@index([timestamp])
}

model ProjectFile {
  id           String           @id @default(cuid())
  fileName     String           @map("file_name")
  fileType     String           @map("file_type")
  fileSize     Int              @map("file_size")
  storagePath  String           @map("storage_path")
  uploadedById String           @map("uploaded_by_id")
  teamId       String           @map("team_id")
  submissionId String?          @map("submission_id")
  version      Int              @default(1)
  isLatest     Boolean          @default(true) @map("is_latest")
  parentFileId String?          @map("parent_file_id")
  createdAt    DateTime         @default(now()) @map("created_at")

  uploadedBy   User             @relation("UserUploadedFiles", fields: [uploadedById], references: [id], onDelete: Cascade)
  team         Team             @relation("TeamFiles", fields: [teamId], references: [id], onDelete: Cascade)
  auditLogs    FileAuditLog[]

  @@index([teamId])
  @@index([submissionId])
}

model FileAuditLog {
  id          String       @id @default(cuid())
  fileId      String       @map("file_id")
  userId      String       @map("user_id")
  action      String       
  details     String?
  timestamp   DateTime     @default(now())

  file        ProjectFile  @relation(fields: [fileId], references: [id], onDelete: Cascade)
  user        User         @relation("UserFileAudits", fields: [userId], references: [id], onDelete: Cascade)

  @@index([fileId])
  @@index([timestamp])
}

model AnalyticsAuditLog {
  id           String   @id @default(cuid())
  userId       String   @map("user_id")
  timestamp    DateTime @default(now())
  actionType   String   // REPORT_GENERATION, EXPORT_ACTIVITY, ANALYTICS_ACCESS
  reportType   String?  // Team, Faculty, Student, Project, Submission, Evaluation, System
  exportFormat String?  // PDF, Excel, CSV, WEB
  details      String?

  @@index([userId])
  @@index([timestamp])
  @@map("analytics_audit_logs")
}

model AuditLog {
  id              String   @id @default(cuid())
  userId          String   @map("user_id")
  userRole        String   @map("user_role")
  actionType      String   @map("action_type") // USER_ACTIVATE, USER_DEACTIVATE, USER_STATUS_RESET, LOGIN, SUBMISSION_CREATE, EVALUATION_SUBMIT, NOTIFICATION_CREATE, UNAUTHORIZED_ACCESS
  entityAffected  String?  @map("entity_affected")
  details         String?
  timestamp       DateTime @default(now())
  eventCategory   String?  @map("event_category")
  entityType      String?  @map("entity_type")
  entityId        String?  @map("entity_id")
  actionPerformed String?  @map("action_performed")
  previousState   String?  @map("previous_state")
  newState        String?  @map("new_state")
  ipAddress       String?  @map("ip_address")
  metadata        String?  @map("metadata")

  @@index([userId])
  @@index([actionType])
  @@index([eventCategory])
  @@index([entityType])
  @@index([entityId])
  @@index([timestamp])
  @@map("audit_logs")
}
